#!/usr/bin/env bash

set -euo pipefail

config_file=/etc/stationconnect/stationconnect.conf
output_file=/etc/X11/xorg.conf.d/99-stationconnect-headless.conf
edid_dir=/usr/share/stationconnect/display
cleanup_only=false
requested_layout=
requested_mode_1=
requested_mode_2=

usage() {
  echo "usage: $0 [--cleanup] [--config FILE] [--output FILE] [--edid-dir DIRECTORY] [--layout LAYOUT --mode-1 MODE [--mode-2 MODE]]" >&2
}

while (($#)); do
  case $1 in
    --cleanup)
      cleanup_only=true
      shift
      ;;
    --config)
      (($# >= 2)) || { usage; exit 2; }
      config_file=$2
      shift 2
      ;;
    --output)
      (($# >= 2)) || { usage; exit 2; }
      output_file=$2
      shift 2
      ;;
    --edid-dir)
      (($# >= 2)) || { usage; exit 2; }
      edid_dir=$2
      shift 2
      ;;
    --layout)
      (($# >= 2)) || { usage; exit 2; }
      requested_layout=$2
      shift 2
      ;;
    --mode-1)
      (($# >= 2)) || { usage; exit 2; }
      requested_mode_1=$2
      shift 2
      ;;
    --mode-2)
      (($# >= 2)) || { usage; exit 2; }
      requested_mode_2=$2
      shift 2
      ;;
    *)
      usage
      exit 2
      ;;
  esac
done

[[ $output_file = /* && $edid_dir = /* ]] || {
  echo "StationConnect display paths must be absolute" >&2
  exit 1
}

display_settings=$(awk '
  function trim(value) {
    sub(/^[[:space:]]+/, "", value)
    sub(/[[:space:]]+$/, "", value)
    return value
  }
  /^[[:space:]]*([#;]|$)/ { next }
  /^[[:space:]]*\[/ {
    section = $0
    sub(/^[[:space:]]*\[/, "", section)
    sub(/\][[:space:]]*$/, "", section)
    section = trim(section)
    next
  }
  section == "display" {
    separator = index($0, "=")
    if (!separator) {
      print "invalid line in [display]: " $0 > "/dev/stderr"
      exit 1
    }
    key = trim(substr($0, 1, separator - 1))
    value = trim(substr($0, separator + 1))
    if (key != "virtual_outputs" &&
        key != "virtual_mode_1" && key != "virtual_mode_2") {
      print "unknown [display] option: " key > "/dev/stderr"
      exit 1
    }
    if (seen[key]++) {
      print "duplicate [display] option: " key > "/dev/stderr"
      exit 1
    }
    values[key] = value
  }
  END {
    if (!values["virtual_outputs"]) values["virtual_outputs"] = "off"
    if (!values["virtual_mode_1"]) values["virtual_mode_1"] = "3840x2160"
    if (!values["virtual_mode_2"]) values["virtual_mode_2"] = "3840x2160"
    print values["virtual_outputs"] "\t" values["virtual_mode_1"] "\t" values["virtual_mode_2"]
  }
' "$config_file") || exit 1

IFS=$'\t' read -r virtual_outputs virtual_mode_1 virtual_mode_2 <<<"$display_settings"
if [[ -n $requested_layout || -n $requested_mode_1 || -n $requested_mode_2 ]]; then
  [[ -n $requested_layout && -n $requested_mode_1 ]] || {
    echo "a requested display transition requires --layout and --mode-1" >&2
    exit 2
  }
  if [[ $virtual_outputs == off ]]; then
    echo "virtual display transitions are disabled by display.virtual_outputs" >&2
    exit 1
  fi
  virtual_outputs=$requested_layout
  virtual_mode_1=$requested_mode_1
  if [[ $virtual_outputs == dual-horizontal ]]; then
    [[ -n $requested_mode_2 ]] || {
      echo "a dual display transition requires --mode-2" >&2
      exit 2
    }
    virtual_mode_2=$requested_mode_2
  elif [[ -n $requested_mode_2 ]]; then
    echo "--mode-2 is valid only for a dual display transition" >&2
    exit 2
  fi
fi
case $virtual_outputs in
  off|single|dual-horizontal) ;;
  *)
    echo "invalid display.virtual_outputs: ${virtual_outputs}" >&2
    exit 1
    ;;
esac
mode_dimensions() {
  case $1 in
    1024x2160) echo '1024 2160' ;;
    1280x720) echo '1280 720' ;;
    1280x1024) echo '1280 1024' ;;
    1280x2160) echo '1280 2160' ;;
    1920x1080) echo '1920 1080' ;;
    1920x1200) echo '1920 1200' ;;
    2560x1440) echo '2560 1440' ;;
    2560x1600) echo '2560 1600' ;;
    2560x2160) echo '2560 2160' ;;
    3440x1440) echo '3440 1440' ;;
    3840x1600) echo '3840 1600' ;;
    3840x2160) echo '3840 2160' ;;
    4096x2160) echo '4096 2160' ;;
    *) return 1 ;;
  esac
}

read -r output_1_width output_1_height < <(mode_dimensions "$virtual_mode_1") || {
  echo "invalid display.virtual_mode_1: ${virtual_mode_1}" >&2
  exit 1
}
read -r output_2_width output_2_height < <(mode_dimensions "$virtual_mode_2") || {
  echo "invalid display.virtual_mode_2: ${virtual_mode_2}" >&2
  exit 1
}
generated_marker="# Generated by StationConnect; do not edit."

remove_owned_overlay_for_uninstall() {
  [[ -e $output_file ]] || return 0
  if ! head -n 1 -- "$output_file" | grep -Fxq -- "$generated_marker"; then
    echo "refusing to remove a display configuration not owned by StationConnect: ${output_file}" >&2
    exit 1
  fi
  rm -f -- "$output_file"
  echo "Removed the StationConnect virtual display overlay; the running X server is unchanged"
}

if [[ $cleanup_only == true ]]; then
  remove_owned_overlay_for_uninstall
  exit 0
fi

[[ -r $config_file ]] || {
  echo "StationConnect host configuration is not readable: ${config_file}" >&2
  exit 1
}

display_manager_active() {
  systemctl is-active --quiet display-manager.service 2>/dev/null
}

remove_overlay() {
  [[ -e $output_file ]] || return 0
  if ! head -n 1 -- "$output_file" | grep -Fxq -- "$generated_marker"; then
    echo "refusing to remove a display configuration not owned by StationConnect: ${output_file}" >&2
    exit 1
  fi
  if display_manager_active; then
    echo "refusing to change the display topology while the display manager is active; reboot to apply the configuration" >&2
    exit 1
  fi
  rm -f -- "$output_file"
  echo "StationConnect virtual outputs are disabled"
}

if [[ $virtual_outputs == off ]]; then
  remove_overlay
  exit 0
fi

required_edids=(
  "virtual-1-${virtual_mode_1}.edid"
  "virtual-2-${virtual_mode_2}.edid"
)
for edid_name in "${required_edids[@]}"; do
  edid_file="${edid_dir}/${edid_name}"
  [[ -r $edid_file ]] || {
    echo "packaged StationConnect EDID is not readable: ${edid_file}" >&2
    exit 1
  }
  # Mutter 40 requests at most 400 bytes from the XRandR EDID property. Keep
  # the complete identity and exact timing pool within three 128-byte blocks.
  expected_edid_size=384
  [[ $(wc -c <"$edid_file") -eq $expected_edid_size ]] || {
    echo "packaged StationConnect EDID has the wrong size (expected ${expected_edid_size} bytes): ${edid_file}" >&2
    exit 1
  }
done

if [[ $virtual_outputs == single ]]; then
  # Keep the second virtual connector available to Xorg but inactive. The host
  # supervisor marks it non-desktop after Xorg starts, hiding it from GNOME
  # until a dual-layout request hot-plugs it through XRandR.
  connected_monitors="DFP-0, DFP-2"
  custom_edid="DFP-0:${edid_dir}/virtual-1-${virtual_mode_1}.edid; DFP-2:${edid_dir}/virtual-2-${virtual_mode_2}.edid"
  metamodes="DFP-0: ${virtual_mode_1} +0+0, DFP-2: NULL"
  canvas_width=$output_1_width
  canvas_height=$output_1_height
else
  connected_monitors="DFP-0, DFP-2"
  custom_edid="DFP-0:${edid_dir}/virtual-1-${virtual_mode_1}.edid; DFP-2:${edid_dir}/virtual-2-${virtual_mode_2}.edid"
  metamodes="DFP-0: ${virtual_mode_1} +0+0, DFP-2: ${virtual_mode_2} +${output_1_width}+0"
  canvas_width=$((output_1_width + output_2_width))
  canvas_height=$((output_1_height > output_2_height ? output_1_height : output_2_height))
fi

output_directory=${output_file%/*}
install -d -m 0755 -- "$output_directory"
temporary_file=$(mktemp -- "${output_file}.tmp.XXXXXX")
cleanup() {
  rm -f -- "$temporary_file"
}
trap cleanup EXIT

cat >"$temporary_file" <<EOF
${generated_marker}
# Boot source: /etc/stationconnect/stationconnect.conf [display]
# The host supervisor may replace this owned overlay with a validated GDM-only request.

Section "ServerFlags"
    Option "DefaultServerLayout" "StationConnect Virtual Display Layout"
EndSection

Section "ServerLayout"
    Identifier "StationConnect Virtual Display Layout"
    Screen 0 "StationConnect Virtual Display Screen" 0 0
EndSection

Section "Device"
    Identifier "StationConnect NVIDIA GPU"
    Driver "nvidia"
    Option "AllowEmptyInitialConfiguration" "True"
    Option "ConnectedMonitor" "${connected_monitors}"
    Option "UseDisplayDevice" "${connected_monitors}"
    Option "CustomEDID" "${custom_edid}"
    Option "MetaModes" "${metamodes}"
    Option "nvidiaXineramaInfoOrder" "DFP-0, DFP-2"
    Option "HardDPMS" "False"
    Option "Interactive" "False"
EndSection

Section "Screen"
    Identifier "StationConnect Virtual Display Screen"
    Device "StationConnect NVIDIA GPU"
    DefaultDepth 30
    SubSection "Display"
        Depth 30
        Virtual ${canvas_width} ${canvas_height}
    EndSubSection
EndSection
EOF
chmod 0644 -- "$temporary_file"

if [[ -e $output_file ]] && cmp -s -- "$temporary_file" "$output_file"; then
  echo "StationConnect virtual display topology is already current: ${virtual_outputs} ${virtual_mode_1} ${virtual_mode_2}"
  exit 0
fi
if display_manager_active; then
  echo "refusing to change the display topology while the display manager is active; reboot to apply the configuration" >&2
  exit 1
fi
mv -f -- "$temporary_file" "$output_file"
trap - EXIT
echo "Prepared StationConnect virtual display topology: ${virtual_outputs} ${virtual_mode_1} ${virtual_mode_2}"
