#!/usr/bin/python3
"""Apply bounded real XRandR modes for a supervisor-owned physical display lease.

Runs as the active desktop owner, never root. No shell, configuration writes,
display-manager restart, or client-provided modelines. The supervisor owns the
baseline MetaMode and invokes cleanup only after restoring that baseline.
"""

import os
import re
import subprocess
import sys
import time

XRANDR = "/usr/bin/xrandr"
NVIDIA = "/usr/bin/nvidia-settings"
CVT = "/usr/bin/cvt"


def command(argv):
    """Run a fixed executable with separate arguments and bounded output/time."""
    result = subprocess.run(argv, text=True, stdout=subprocess.PIPE,
                            stderr=subprocess.PIPE, timeout=5, check=True)
    if len(result.stdout) > 256 * 1024:
        raise ValueError("Display command output exceeds limit")
    # nvidia-settings can exit successfully even when an assignment is rejected.
    if argv[0] == NVIDIA and re.search(r"\bERROR:", result.stderr):
        raise ValueError("NVIDIA rejected the display command")
    return result.stdout


def dimensions(mode):
    """Validate the canonical wire mode before any display command is run."""
    if not re.fullmatch(r"[1-9][0-9]{2,3}x[1-9][0-9]{2,3}", mode):
        raise ValueError("Invalid matched display mode")
    width, height = map(int, mode.split("x"))
    if not (320 <= width <= 8192 and 200 <= height <= 8192) or width % 2 or height % 2:
        raise ValueError("Matched display dimensions are out of bounds")
    return width, height


def outputs(query):
    """Read connected outputs and their actual CRTC rectangles from XRandR."""
    result = []
    for line in query.splitlines():
        match = re.match(r"^([A-Za-z0-9_-]+) connected(?: (primary))?(?: (\d+)x(\d+)\+(-?\d+)\+(-?\d+))? ", line)
        if match:
            name, primary, width, height, x, y = match.groups()
            panning = re.search(r" panning (\d+)x(\d+)\+(-?\d+)\+(-?\d+)", line)
            result.append({"name": name, "primary": bool(primary),
                           "rect": tuple(map(int, (width, height, x, y))) if width else None,
                           "panning": tuple(map(int, panning.groups())) if panning else None})
    return result


def ordered_outputs(items, count, primary_index=-1):
    """Keep the Host primary output's identity when matching Client positions.

    Some applications enumerate physical outputs independently of the XRandR
    primary flag. Assigning the first active output to the leftmost Client
    screen can therefore move their main UI to a secondary Client display.
    Prefer the active Host primary, or its first active output if the primary
    property names an inactive connector. Place that output at the requested
    Client primary index; use desktop order for the remaining outputs.
    """
    ordered = sorted(items, key=lambda item: (item["rect"] is None,
                     item["rect"][2:] if item["rect"] else (0, 0), item["name"]))
    if len(ordered) < count:
        raise ValueError("Not enough connected outputs for matched displays")
    if primary_index >= 0:
        active = [item for item in ordered if item["rect"]]
        primary = next((item for item in active if item["primary"]), None)
        if primary is None:
            primary = active[0] if active else next(
                (item for item in ordered if item["primary"]), ordered[0])
        selected = [item for item in ordered if item is not primary][:count - 1]
        selected.insert(primary_index, primary)
        return selected
    return ordered[:count]


def modeline(width, height):
    """Generate reduced-blanking 60 Hz timing on the Host, retaining exact width.

    CVT rounds active width to eight pixels. Generate its timing envelope using
    the next eight-pixel width, then retain the requested even active width.
    The extra 0..6 pixels become front porch; totals/clock/refresh are unchanged.
    """
    text = command([CVT, "-r", str((width + 7) // 8 * 8), str(height), "60"])
    match = re.search(r'^Modeline "[^"\n]+"\s+(.+)$', text, re.MULTILINE)
    if not match:
        raise ValueError("CVT did not return a modeline")
    fields = match.group(1).split()
    if len(fields) != 11 or fields[-2:] != ["+hsync", "-vsync"]:
        raise ValueError("Unexpected CVT timing format")
    clock = float(fields[0])
    timing = list(map(int, fields[1:9]))
    timing[0] = width
    if not (0 < clock <= 2000 and width < timing[1] < timing[2] < timing[3] and
            timing[4] == height < timing[5] < timing[6] < timing[7]):
        raise ValueError("Invalid CVT timing bounds")
    return [fields[0]] + list(map(str, timing)) + fields[-2:]


def mutter_state():
    """Read the active desktop owner's GNOME display state."""
    from gi.repository import Gio
    os.environ.setdefault("DBUS_SESSION_BUS_ADDRESS", "unix:path=" + os.environ["XDG_RUNTIME_DIR"] + "/bus")
    bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    state = bus.call_sync("org.gnome.Mutter.DisplayConfig", "/org/gnome/Mutter/DisplayConfig",
                          "org.gnome.Mutter.DisplayConfig", "GetCurrentState", None, None,
                          Gio.DBusCallFlags.NONE, 2000, None).unpack()
    return bus, state


def mutter_geometry():
    """Return GNOME's actual active mode and logical rectangle per output."""
    _bus, state = mutter_state()
    current = {}
    for spec, modes, _properties in state[1]:
        for mode in modes:
            if mode[6].get("is-current"):
                current[spec[0]] = tuple(mode[1:3])
    result = {}
    for x, y, scale, transform, primary, specs, _properties in state[2]:
        for spec in specs:
            if spec[0] in current:
                result[spec[0]] = (*current[spec[0]], x, y, scale, transform, primary)
    return result


def single_mutter_request(state, output):
    """Choose the one exact advertised mode for a restored physical output."""
    width, height, x, y = output["rect"]
    if (x, y) != (0, 0):
        raise ValueError("Cannot recover a displaced single physical output")
    monitor = next((m for m in state[1] if m[0][0] == output["name"]), None)
    if monitor is None:
        raise ValueError("Restored physical output is absent from GNOME")
    candidates = [mode for mode in monitor[1] if mode[1:3] == (width, height)]
    current = [mode for mode in candidates if mode[6].get("is-current")]
    selected = current if len(current) == 1 else candidates
    if len(selected) != 1:
        raise ValueError("GNOME has no unambiguous restored physical mode")
    return state[0], [(0, 0, 1.0, 0, True,
                       [(output["name"], selected[0][0], {})])]


def recover_single_mutter_output(output):
    """Make a restored XRandR output visible when GNOME retained no monitor."""
    from gi.repository import Gio, GLib
    bus, state = mutter_state()
    serial, logical_monitors = single_mutter_request(state, output)
    parameters = GLib.Variant("(uua(iiduba(ssa{sv}))a{sv})",
                              (serial, 1, logical_monitors, {}))
    bus.call_sync("org.gnome.Mutter.DisplayConfig", "/org/gnome/Mutter/DisplayConfig",
                  "org.gnome.Mutter.DisplayConfig", "ApplyMonitorsConfig", parameters,
                  None, Gio.DBusCallFlags.NONE, 3000, None)


def ensure_restored_mutter_output(primary):
    """Require GNOME to expose the restored desktop, not only NVIDIA/XRandR."""
    active = [item for item in outputs(command([XRANDR, "--query"])) if item["rect"]]
    if not active:
        raise ValueError("Restored NVIDIA layout has no active physical output")
    single = active[0] if len(active) == 1 else None
    def visible(geometry):
        if single is None:
            return bool(geometry)
        reported = geometry.get(single["name"])
        return bool(reported and reported[:4] == single["rect"] and
                    (primary != single["name"] or reported[6]))

    deadline = time.monotonic() + 6
    while True:
        if visible(mutter_geometry()):
            return
        if time.monotonic() >= deadline:
            break
        time.sleep(0.2)
    if single is None or primary != single["name"]:
        raise ValueError("GNOME retained an invalid logical monitor layout after restoration")
    recover_single_mutter_output(single)
    if not visible(mutter_geometry()):
        raise ValueError("GNOME did not activate the restored physical output")


def verify(expected, primary=None):
    """Wait briefly for both XRandR and GNOME to acknowledge exact geometry."""
    deadline = time.monotonic() + 6
    while True:
        active = [item for item in outputs(command([XRANDR, "--query"])) if item["rect"]]
        actual = {item["name"]: item["rect"] for item in active}
        # A correct CRTC position alone is not sufficient: the NVIDIA viewport
        # can move later if its retained panning domain is larger than the mode.
        fixed_viewports = all(item["panning"] is None or item["panning"] == item["rect"]
                              for item in active)
        compositor = mutter_geometry()
        primary_matches = primary is None or (
            [item["name"] for item in active if item["primary"]] == [primary] and
            [name for name, rect in compositor.items() if rect[6]] == [primary])
        if fixed_viewports and primary_matches and actual == expected and {
                name: rect[:6] for name, rect in compositor.items()
        } == {name: (*rect, 1.0, 0) for name, rect in expected.items()}:
            return
        if time.monotonic() >= deadline:
            raise ValueError("XRandR and GNOME did not agree on the matched display geometry")
        time.sleep(0.2)


def mode_names(token):
    """Accept only a supervisor-generated lease identity."""
    if not re.fullmatch(r"[0-9]{1,20}-[0-9]{1,20}", token):
        raise ValueError("Invalid display lease identity")
    return ["PLANK-Match-" + token + "-" + str(index) for index in (0, 1)]


def cleanup(token):
    """Delete only this lease's generated modes after they are no longer active."""
    names = mode_names(token)
    query = command([XRANDR, "--query"])
    # Do not remove an active mode if restoration failed.
    for line in query.splitlines():
        if any(line.lstrip().startswith(name + " ") for name in names) and "*" in line:
            raise ValueError("Matched mode is still active; retaining it for recovery")
    attached = None
    found = set()
    for line in query.splitlines():
        header = re.match(r"^([A-Za-z0-9_-]+) (?:dis)?connected", line)
        if header:
            attached = header.group(1)
        elif line and not line[0].isspace():
            attached = None
        for name in names:
            if line.lstrip().startswith(name + " "):
                found.add(name)
                if attached:
                    command([XRANDR, "--delmode", attached, name])
    for name in found:
        command([XRANDR, "--rmmode", name])


def apply(token, modes, primary_index=-1):
    """Apply transactionally; restore the exact initial MetaMode on any failure."""
    names = mode_names(token)
    sizes = [dimensions(mode) for mode in modes]
    if len(sizes) not in (1, 2) or sum(size[0] for size in sizes) > 8192:
        raise ValueError("Matched canvas exceeds supported bounds")
    if primary_index not in range(-1, len(sizes)):
        raise ValueError("Invalid primary display index")
    before = command([XRANDR, "--query"])
    if any(name in before for name in names):
        raise ValueError("Display lease mode identity already exists")
    items = outputs(before)
    selected = ordered_outputs(items, len(sizes), primary_index)
    primary = next((item["name"] for item in items if item["primary"]), None)
    baseline = command([NVIDIA, "--query", "CurrentMetaMode", "--terse"]).partition("::")[2].strip()
    if not baseline or len(baseline) > 32768:
        raise ValueError("Cannot capture baseline NVIDIA MetaMode")
    # Establish compositor availability before the first write.
    mutter_geometry()
    created = []
    attached = []
    try:
        expected = {}
        x = 0
        args = [XRANDR, "--fb", str(sum(w for w, _h in sizes)) + "x" + str(max(h for _w, h in sizes))]
        for index, (item, (width, height)) in enumerate(zip(selected, sizes)):
            name = names[index]
            command([XRANDR, "--newmode", name] + modeline(width, height))
            created.append(name)
            command([XRANDR, "--addmode", item["name"], name])
            attached.append((item["name"], name))
            expected[item["name"]] = (width, height, x, 0)
            args += ["--output", item["name"], "--mode", name, "--pos", str(x) + "x0",
                     "--rotate", "normal", "--transform", "none",
                     "--panning", f"{width}x{height}+{x}+0"]
            x += width
        for item in items:
            if item not in selected:
                args += ["--output", item["name"], "--off"]
        matched_primary = selected[primary_index]["name"] if primary_index >= 0 else None
        if matched_primary:
            args += ["--output", matched_primary, "--primary"]
        command(args)
        verify(expected, matched_primary)
    except Exception:
        restore(baseline, primary or "none")
        for output, name in reversed(attached):
            command([XRANDR, "--delmode", output, name])
        for name in reversed(created):
            command([XRANDR, "--rmmode", name])
        raise


def current_primary():
    """Return the XRandR primary property, even for an inactive output."""
    return next((item["name"] for item in outputs(command([XRANDR, "--query"]))
                 if item["primary"]), "none")


def restore(baseline, primary="keep"):
    """Restore NVIDIA, XRandR primary, and GNOME's visible desktop."""
    if not baseline or len(baseline) > 32768 or any(ord(c) < 32 or ord(c) > 126 for c in baseline):
        raise ValueError("Invalid baseline MetaMode")
    if primary not in ("keep", "none") and not re.fullmatch(r"[A-Za-z0-9_-]{1,64}", primary):
        raise ValueError("Invalid primary output")
    command([NVIDIA, "--assign", "CurrentMetaMode=" + baseline])
    actual = command([NVIDIA, "--query", "CurrentMetaMode", "--terse"]).partition("::")[2].strip()
    if "".join(actual.split()) != "".join(baseline.split()):
        raise ValueError("Baseline MetaMode restoration did not take effect")
    if primary != "keep":
        command([XRANDR, "--noprimary"] if primary == "none" else
                [XRANDR, "--output", primary, "--primary"])
        if current_primary() != primary:
            raise ValueError("Primary output restoration did not take effect")
    ensure_restored_mutter_output(current_primary() if primary == "keep" else primary)
    # Mutter recovery can itself reconfigure XRandR. Recheck the exact lease
    # baseline before the supervisor releases the temporary modes.
    actual = command([NVIDIA, "--query", "CurrentMetaMode", "--terse"]).partition("::")[2].strip()
    if "".join(actual.split()) != "".join(baseline.split()) or (
            primary != "keep" and current_primary() != primary):
        raise ValueError("GNOME recovery changed the restored physical layout")


def main(argv):
    """The two privileged-supervisor operations; execution itself is unprivileged."""
    if os.geteuid() == 0:
        raise ValueError("Display matching must run as the desktop owner")
    if len(argv) in (5, 6) and argv[1] == "apply" and argv[3] in ("-1", "0", "1"):
        apply(argv[2], argv[4:], int(argv[3]))
    elif len(argv) == 2 and argv[1] == "primary":
        print(current_primary())
    elif len(argv) == 4 and argv[1] == "restore":
        restore(argv[2], argv[3])
    elif len(argv) == 3 and argv[1] == "cleanup":
        cleanup(argv[2])
    else:
        raise ValueError("Usage: plank-display-match apply TOKEN PRIMARY MODE [MODE] | cleanup TOKEN | primary | restore METAMODE PRIMARY")


if __name__ == "__main__":
    try:
        main(sys.argv)
    except Exception as error:
        print("PLANK display matching failed: " + str(error), file=sys.stderr)
        sys.exit(1)
