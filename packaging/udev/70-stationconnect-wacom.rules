# Permit the active local session to read and grab only Wacom pen-tool nodes.
# Pad and touch interfaces require separate protocol support before redirection.
ACTION!="remove", SUBSYSTEM=="input", KERNEL=="event*", ENV{ID_VENDOR_ID}=="056a", ENV{ID_INPUT_TABLET}=="1", ENV{ID_INPUT_TABLET_PAD}!="1", ENV{ID_INPUT_TOUCHPAD}!="1", TAG+="uaccess"

# Raw-HID redirection discovers every interface and must answer feature/output
# reports as well as read input reports. Access remains scoped to the active
# local session and Wacom's USB vendor ID.
ACTION!="remove", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="056a", TAG+="uaccess"
