#!/bin/bash
set -euo pipefail
source "$(/usr/bin/dirname "$0")/pkg-common.sh"
preflight "${3:-}"
stop_roles
for label in "$machine" "$desktop" "$signin"; do
    path=$(job_path "$label")
    if present "$path"; then /bin/rm "$path"; fi
done
if present "$app"; then
    verify_app yes
    /bin/rm -rf '/Applications/PLANK Host.app'
fi
if /usr/sbin/pkgutil --pkg-info la.instinctual.PLANK.Host >/dev/null 2>&1; then
    /usr/sbin/pkgutil --forget la.instinctual.PLANK.Host
fi
echo 'PLANK Host removed. Configuration, certificates, logs and privacy permissions preserved. No reboot required.'
