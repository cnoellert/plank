#!/bin/sh
set -eu
[ "${3:-}" = / ] || exit 1
script_dir=$(/usr/bin/dirname "$0")
if ! "$script_dir/plank-host-installer" finish /; then
    "$script_dir/plank-host-installer" recover / || true
    echo 'PLANK installation failed. See Installer Log; the previous app is retained for recovery.' >&2
    exit 1
fi
