#%PAM-1.0
# StationConnect delegates account authorization to the host's standard
# PAM/SSSD policy. Root remote login remains a product-level prohibition.
auth       requisite    pam_succeed_if.so quiet user != root
auth       substack     system-auth
auth       include      postlogin

account    required     pam_succeed_if.so quiet user != root
account    include      system-auth

password   include      system-auth

session    optional     pam_keyinit.so force revoke
session    include      system-auth
session    include      postlogin
