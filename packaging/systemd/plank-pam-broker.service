[Unit]
Description=PLANK PAM authentication broker
After=systemd-user-sessions.service
Before=plank-host.service

[Service]
Type=simple
ExecStart=/usr/libexec/plank/plank-pam-broker --socket /run/plank/pam/auth.sock --config /etc/plank/host.conf
User=root
Group=root
RuntimeDirectory=plank/pam
RuntimeDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=1s
KillMode=control-group
TasksMax=40

NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=read-only
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=full
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@mount @reboot @swap

[Install]
WantedBy=multi-user.target
