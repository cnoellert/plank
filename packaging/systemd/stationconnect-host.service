[Unit]
Description=StationConnect workstation host
After=graphical-session.target network-online.target
PartOf=graphical-session.target

[Service]
Type=simple
EnvironmentFile=-%h/.config/stationconnect/host.env
ExecStart=/usr/bin/stationconnect-host
Restart=always
RestartSec=2s
TimeoutStopSec=10s
UMask=0077

[Install]
WantedBy=graphical-session.target
