[Unit]
Description=StationConnect workstation host
After=graphical-session.target network-online.target
PartOf=graphical-session.target

[Service]
Type=simple
EnvironmentFile=-%h/.config/stationconnect/host.env
ExecStart=/usr/bin/stationconnect-host $STATIONCONNECT_HOST_OPTIONS
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=graphical-session.target
