# Sunshine binds all IPv4/IPv6 interfaces when bind_address is omitted.
# Select the qualified workstation output and encoder in package provisioning.
# Production packages install the default binary under /usr/libexec/stationconnect.
# STATIONCONNECT_HOST_BINARY=/path/to/development/sunshine
STATIONCONNECT_HOST_OPTIONS=address_family=both output_name=1 encoder=software-cuda min_threads=16 sw_preset=ultrafast sw_tune=zerolatency sw_vbv_maxrate_percentage=150 sw_vbv_buffer_frames=4 sw_scenecut=40
