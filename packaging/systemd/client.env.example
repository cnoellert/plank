# Production packages install the default binary under /usr/libexec/stationconnect.
# STATIONCONNECT_CLIENT_BINARY=/path/to/development/stationconnect-client
# STATIONCONNECT_CLIENT_LIBDIR=/path/to/private/libraries
# Uncomment to administratively lock client mDNS discovery off or on.
# When omitted, discovery defaults off but remains editable in Client Settings.
# STATIONCONNECT_MDNS_DISCOVERY=0
