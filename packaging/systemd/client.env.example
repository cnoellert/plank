# Restrict StationConnect TLS control and credentials to this interface.
# Discovery and media transport continue to use all interfaces.
# Production packages install the default binary under /usr/libexec/stationconnect.
# STATIONCONNECT_CLIENT_BINARY=/path/to/development/moonlight
# STATIONCONNECT_CLIENT_LIBDIR=/path/to/private/libraries
STATIONCONNECT_VPN_INTERFACE=ztstationconnect
