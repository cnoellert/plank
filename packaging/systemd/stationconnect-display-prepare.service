[Unit]
Description=Prepare StationConnect virtual displays
Documentation=file:/usr/share/doc/stationconnect-host/README.md
Before=display-manager.service
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/stationconnect/stationconnect-display-prepare
RemainAfterExit=yes
UMask=0022
NoNewPrivileges=yes
CapabilityBoundingSet=
LockPersonality=yes
MemoryDenyWriteExecute=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=/etc/X11/xorg.conf.d
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=yes
SystemCallArchitectures=native

[Install]
WantedBy=graphical.target
